@import "tailwindcss";

/* ── Base resets ──────────────────────────────────────── */
*,
*::before,
*::after {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

body {
  font-family: "Inter", system-ui, -apple-system, sans-serif;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  @apply bg-blue-50 text-slate-900 min-h-screen bg-fixed;
  /* Light medical background pattern */
  background-image:
    radial-gradient(at 0% 0%, hsla(213, 94%, 94%, 1) 0px, transparent 50%),
    radial-gradient(at 100% 100%, hsla(213, 100%, 96%, 1) 0px, transparent 50%),
    radial-gradient(at 50% 50%, hsla(213, 100%, 100%, 1) 0px, transparent 50%);
}

/* ── Scrollbar styling ────────────────────────────────── */
::-webkit-scrollbar {
  width: 6px;
  height: 6px;
}

::-webkit-scrollbar-track {
  background: rgba(0, 0, 0, 0.02);
}

::-webkit-scrollbar-thumb {
  background: rgba(0, 0, 0, 0.1);
  border-radius: 3px;
}

/* ── SaaS UI Utilities ────────────────────────────────── */
.glass-card {
  @apply bg-white border border-blue-50/50 rounded-[24px];
  box-shadow: 0 10px 40px -10px rgba(37, 99, 235, 0.08);
  /* Re-applied natively */
}

.glow {
  box-shadow: 0 0 20px rgba(37, 99, 235, 0.15);
}

.glow-hover:hover {
  box-shadow: 0 0 25px rgba(37, 99, 235, 0.25);
}

/* Custom fade in animation used globally */
@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateY(10px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.animate-fade-in {
  animation: fadeIn 0.4s ease-out forwards;
}

/* ── Status colors ────────────────────────────────────── */
.status-open {
  background: #3b82f6;
}

.status-confirmed {
  background: #60a5fa;
}

.status-checked-in {
  background: #22d3ee;
}

.status-in-progress {
  background: #a78bfa;
}

.status-completed {
  background: #22c55e;
}

.status-delayed {
  background: #f97316;
}

.status-cancelled {
  background: #f472b6;
}

.status-no-show {
  background: #ef4444;
}

.status-waiting-list {
  background: #eab308;
}