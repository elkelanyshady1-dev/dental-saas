{
    "name": "frontend",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "lint": "eslint .",
        "test": "echo 'No frontend tests yet'",
        "test:frontend": "vitest",
        "test:platform-contract": "node ../backend/scripts/exportPlatformContract.js && vitest run src/platform/__tests__/platformContract.test.js",
        "type-check": "echo 'JS Project — Skipping TS type check'",
        "preview": "vite preview",
        "lint:imports": "node scripts/checkRelativeServiceImports.js",
        "lint:jsx": "node scripts/checkJSXTypeLeakage.js",
        "lint:platform": "node ../scripts/checkPlatformIsolation.js",
        "lint:org-caps": "node scripts/lintOrgCapabilities.cjs",
        "lint:branding": "node ../scripts/checkBranding.js",
        "design:validate": "node scripts/validateDesignTokens.js",
        "design:validate:warn": "node scripts/validateDesignTokens.js --warn-only",
        "lint:all": "npm run lint && npm run lint:imports && npm run lint:jsx && npm run lint:org-caps && npm run lint:branding && npm run design:validate:warn",
        "generate:capabilities": "node scripts/generateCapabilities.js",
        "generate:platform-api": "swagger-typescript-api generate -p ../backend/openapi/platform.yaml -o src/platform/core/api/generated --axios --module-name-first-tag --extract-request-params --extract-response-body --js"
    },
    "dependencies": {
        "@dnd-kit/core": "^6.3.1",
        "@dnd-kit/modifiers": "^9.0.0",
        "@dnd-kit/sortable": "^10.0.0",
        "@heroicons/react": "^2.2.0",
        "@react-google-maps/api": "^2.20.8",
        "@react-three/drei": "^10.7.7",
        "@react-three/fiber": "^9.5.0",
        "@tanstack/react-query": "^5.62.0",
        "@tanstack/react-table": "^8.21.3",
        "axios": "^1.13.5",
        "browser-image-compression": "^2.0.2",
        "clsx": "^2.1.1",
        "cornerstone-core": "^2.6.1",
        "cornerstone-tools": "^6.0.10",
        "cornerstone-wado-image-loader": "^4.13.2",
        "date-fns": "^4.1.0",
        "dicom-parser": "^1.8.21",
        "framer-motion": "^12.38.0",
        "html-to-image": "^1.11.13",
        "html2canvas": "^1.4.1",
        "i18next": "^23.16.8",
        "i18next-browser-languagedetector": "^8.2.1",
        "idb": "^8.0.3",
        "jspdf": "^4.2.1",
        "jwt-decode": "^4.0.0",
        "lucide-react": "^0.575.0",
        "motion": "^12.38.0",
        "react": "^19.2.0",
        "react-big-calendar": "^1.19.4",
        "react-dom": "^19.2.0",
        "react-easy-crop": "^5.5.6",
        "react-hot-toast": "^2.6.0",
        "react-i18next": "^14.1.3",
        "react-is": "^19.2.4",
        "react-router-dom": "^7.13.0",
        "recharts": "^3.7.0",
        "socket.io-client": "^4.8.3",
        "tailwind-merge": "^3.5.0",
        "tailwindcss-animate": "^1.0.7",
        "three": "^0.183.2",
        "zustand": "^5.0.11"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.1",
        "@playwright/test": "^1.58.2",
        "@testing-library/react": "^16.3.2",
        "@types/react": "^19.2.7",
        "@types/react-dom": "^19.2.3",
        "@vitejs/plugin-react": "^5.1.4",
        "autoprefixer": "^10.4.24",
        "eslint": "^9.39.3",
        "eslint-plugin-boundaries": "^5.4.0",
        "eslint-plugin-react-hooks": "^7.0.1",
        "eslint-plugin-react-refresh": "^0.4.24",
        "globals": "^16.5.0",
        "jsdom": "^28.1.0",
        "postcss": "^8.5.6",
        "swagger-typescript-api": "^13.2.18",
        "tailwindcss": "^3.4.4",
        "vite": "^7.3.1",
        "vitest": "^4.0.18"
    }
}
