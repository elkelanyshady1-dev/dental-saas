# .env.example — Platform Frontend Configuration
# Copy to .env and fill in values for your environment.
# DO NOT commit .env with real secrets.

# API Base URL — used by platformApi.js
# Leave empty to use the Vite dev proxy (default: /api)
# Set to a full URL for direct backend connection or cross-domain production:
#   Local:       VITE_API_URL=http://localhost:5000/api
#   Staging:     VITE_API_URL=https://staging-api.yourdomain.com/api
#   Production:  VITE_API_URL=https://api.yourdomain.com/api
#   Same-origin: VITE_API_URL=/api
VITE_API_URL=
