# =============================================================================
# DentalSaaS Platform — Environment Variables Reference
# v3.0 — Email System Upgrade (Redis Queue + Ethereal/SES)
# =============================================================================
# Copy this file to .env and fill in values for your environment.
# NEVER commit .env to version control.
# =============================================================================

# ─── Core ─────────────────────────────────────────────────────────────────────
NODE_ENV=development          # development | staging | production
PORT=5000
FRONTEND_URL=http://localhost:3000
PLATFORM_NAME=DentalSaaS

# ─── Database ─────────────────────────────────────────────────────────────────
MONGO_URI=mongodb://127.0.0.1:27017/dental-saas

# ─── Redis (REQUIRED — used by BullMQ email queue + cron locks) ───────────────
# Prefer REDIS_URL (cloud providers like Railway/Render/Upstash):
REDIS_URL=redis://127.0.0.1:6379
# Or use individual fields (REDIS_URL takes priority if both are set):
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# REDIS_PASSWORD=your_redis_password   # uncomment if Redis auth is enabled

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Shared fallback (used if plane-specific secrets are not set):
JWT_SECRET=change_me_minimum_32_chars_long_random_string
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=change_me_minimum_32_chars_refresh_string
JWT_REFRESH_EXPIRES_IN=7d

# Plane-isolated signing keys (RECOMMENDED — set both for full isolation):
# When set, org tokens use JWT_ORG_SECRET and platform tokens use JWT_PLATFORM_SECRET.
# When NOT set, both planes fall back to JWT_SECRET.
JWT_ORG_SECRET=change_me_org_plane_secret_minimum_32_chars
JWT_PLATFORM_SECRET=change_me_platform_plane_secret_minimum_32_chars

# ─── Email — Sender Identity (all environments) ───────────────────────────────
SMTP_FROM_ADDRESS=noreply@yourdomain.com
SMTP_FROM_NAME=DentalSaaS Platform
SUPPORT_EMAIL=support@yourdomain.com

# ─── Email — Development (Ethereal — auto-created, no config needed) ──────────
# When NODE_ENV=development, Ethereal is used automatically.
# A preview URL is printed to the console for every email sent.
# No SMTP credentials required in development.

# ─── Email — Staging (Mailtrap or any SMTP provider) ─────────────────────────
# Used when NODE_ENV=staging or NODE_ENV=test
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_mailtrap_username
SMTP_PASS=your_mailtrap_password

# ─── Email — Production (AWS SES) ─────────────────────────────────────────────
# Option A: AWS SES via SMTP (recommended for simplicity)
# SMTP_HOST=email-smtp.us-east-1.amazonaws.com
# SMTP_PORT=587
# SMTP_USER=AKIAIOSFODNN7EXAMPLE          # SES SMTP username (IAM key)
# SMTP_PASS=wJalrXUtnFEMI/K7MDENG/bPxRfiXXXXX   # SES SMTP password

# Option B: AWS SES via SDK (requires @aws-sdk/client-sesv2 + nodemailer-ses-transport)
# AWS_SES_REGION=us-east-1
# AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
# AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiXXXXX

# ─── Stripe ───────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_your_stripe_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key

# ─── Feature Flags ──────────────────────────────────────────────────────────
ALLOW_SUPERADMIN_DEV_BYPASS=false   # DO NOT set to true in production
METRICS_ENABLED=false
AUTH_TRACE=false
TEMPLATE_CACHE=false                 # true in production (caches compiled HBS templates)
PLATFORM_GUARDIAN_MODE=warn          # warn | strict
POLICY_SHADOW_MODE=true              # true = log denials but don't enforce, false = normal enforcement

# ─── Entitlement Dev Bypass ──────────────────────────────────────────────────
# BYPASS_ENTITLEMENTS=true   — skip ALL plan/entitlement checks (dev/staging only)
#   Effects:
#     • requireEntitlement() → always next()
#     • unifiedCapabilityMiddleware → injects orthodontics: true into req.capabilities
#     • subscriptionGuard → ignores plan resolution failure (no contract required)
#   DO NOT set in production. Remove or set to false before go-live.
BYPASS_ENTITLEMENTS=false
# ENTITLEMENT_AUDIT_MODE=true  — log denials but allow (softer bypass, legacy)
ENTITLEMENT_AUDIT_MODE=false

# ─── Miscellaneous ────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=https://yourdomain.com    # Comma-separated for multiple origins
