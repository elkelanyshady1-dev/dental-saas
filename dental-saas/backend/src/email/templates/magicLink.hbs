{{#> layout subject=subject}}
{{#*inline "body"}}
<p style="font-size:15px; margin:0 0 8px;">Hello <strong>{{or name email}}</strong>,</p>
<p style="color:#64748b; font-size:14px; margin:0 0 24px; line-height:1.6;">
    You requested a magic login link for your <strong>{{platformName}}</strong> account.
    Click the button below to sign in instantly — no password needed.
</p>

<div style="text-align:center;">
    <a class="btn" href="{{link}}">Sign In to {{platformName}}</a>
</div>

<hr class="divider" />

<table class="data">
    <tr>
        <th>Expires in</th>
        <td>10 minutes</td>
    </tr>
    <tr>
        <th>Requested at</th>
        <td>{{formatDate requestedAt}}</td>
    </tr>
    {{#if ipAddress}}<tr>
        <th>From IP</th>
        <td>{{ipAddress}}</td>
    </tr>{{/if}}
</table>

<p style="font-size:13px; color:#888; margin-top:24px; line-height:1.6;">
    If you did not request this link, you can safely ignore this email.
    Your account is secure — this link will expire automatically.
</p>
{{/inline}}
{{/layout}}