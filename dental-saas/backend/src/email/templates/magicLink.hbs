{{#> layout subject=subject}}
{{#*inline "body"}}
<p style="font-size: 16px; margin: 0 0 8px; font-weight: 600;">Hello <strong>{{or name email}}</strong>,</p>
<p style="color: #64748b; font-size: 14px; margin: 0 0 28px; line-height: 1.7;">
    You requested a magic login link for your <strong>OrthoNoe</strong> account.
    Click the button below to sign in instantly — no password needed.
</p>

<div style="text-align: center;">
    <table cellpadding="0" cellspacing="0" border="0" align="center">
        <tr>
            <td style="background: #2563eb; border-radius: 10px; box-shadow: 0 4px 14px rgba(37,99,235,0.3);">
                <a href="{{link}}" style="display: inline-block; padding: 16px 40px; color: #ffffff; text-decoration: none; font-weight: 700; font-size: 15px; letter-spacing: 0.3px;">
                    Sign In to OrthoNoe
                </a>
            </td>
        </tr>
    </table>
</div>

<hr class="divider" />

<table class="data">
    <tr>
        <th>Expires in</th>
        <td><span class="pill pill-amber">10 minutes</span></td>
    </tr>
    <tr>
        <th>Requested at</th>
        <td>{{formatDate requestedAt}}</td>
    </tr>
    {{#if ipAddress}}
    <tr>
        <th>From IP</th>
        <td style="font-family: monospace; font-size: 13px;">{{ipAddress}}</td>
    </tr>
    {{/if}}
</table>

<p style="font-size: 13px; color: #64748b; margin-top: 24px; line-height: 1.7;">
    If the button doesn't work, copy and paste this URL into your browser:
</p>
<p style="word-break: break-all; font-size: 13px; color: #2563eb; background: #f8fafc; padding: 12px 16px; border-radius: 8px; border: 1px solid #e2e8f0;">
    {{link}}
</p>

<div class="info-box">
    If you did not request this link, you can safely ignore this email.
    Your account is secure — this link will expire automatically.
</div>
{{/inline}}
{{/layout}}