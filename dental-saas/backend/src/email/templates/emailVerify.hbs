{{#> layout subject=subject}}
{{#*inline "body"}}
<p style="font-size:15px; margin:0 0 8px;">Hello <strong>{{or name email}}</strong>,</p>
<p style="color:#64748b; font-size:14px; margin:0 0 24px; line-height:1.6;">
    Thank you for registering! Please verify your email address to enable password recovery
    and important notifications for your account.
</p>

<div style="text-align:center; margin:32px 0;">
    <a href="{{verifyUrl}}" 
       style="display:inline-block; background:linear-gradient(135deg, #2563eb 0%, #1d4ed8 100%);
              color:#fff; text-decoration:none; padding:16px 48px; border-radius:8px;
              font-size:16px; font-weight:600; letter-spacing:0.5px;">
        Verify Email Address
    </a>
</div>

<table class="data">
    <tr>
        <th>Expires in</th>
        <td>24 hours</td>
    </tr>
    <tr>
        <th>Issued at</th>
        <td>{{formatDate issuedAt}}</td>
    </tr>
</table>

<p style="font-size:13px; color:#888; margin-top:24px; line-height:1.6;">
    If you did not create an account, please ignore this email.
    This link can only be used once and will expire after 24 hours.
</p>

<p style="font-size:11px; color:#aaa; margin-top:16px; word-break:break-all;">
    If the button above doesn't work, copy and paste this URL into your browser:<br/>
    <a href="{{verifyUrl}}" style="color:#2563eb;">{{verifyUrl}}</a>
</p>
{{/inline}}
{{/layout}}
