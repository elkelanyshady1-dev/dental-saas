{{#> layout subject=subject}}
{{#*inline "body"}}
<!--
  Email Verification Template
  Sent during signup flow to verify email ownership.
-->
<p style="font-size: 16px; margin: 0 0 8px; font-weight: 600;">Welcome to <strong>OrthoNoe</strong>!</p>
<p style="color: #64748b; font-size: 14px; margin: 0 0 28px; line-height: 1.7;">
    Please verify your email address to complete your account setup.
    Enter the code below in the verification screen.
</p>

<div style="text-align: center; margin: 36px 0;">
    <table cellpadding="0" cellspacing="0" border="0" align="center" style="margin: 0 auto;">
        <tr>
            <td style="background: linear-gradient(135deg, #ecfdf5, #f0fdf4); border: 2px solid #10b981; border-radius: 16px; padding: 28px 56px; text-align: center;">
                <p style="margin: 0 0 6px; font-size: 10px; color: #065f46; text-transform: uppercase; letter-spacing: 3px; font-weight: 700;">
                    Email Verification Code
                </p>
                <p style="margin: 0; font-size: 44px; font-weight: 900; letter-spacing: 14px; color: #0f172a; font-family: 'Courier New', monospace;">
                    {{otp}}
                </p>
            </td>
        </tr>
    </table>
</div>

<table class="data">
    <tr>
        <th>Expires in</th>
        <td><span class="pill pill-amber">10 minutes</span></td>
    </tr>
    {{#if email}}
    <tr>
        <th>Email</th>
        <td>{{email}}</td>
    </tr>
    {{/if}}
</table>

<div class="info-box">
    If you did not create an OrthoNoe account, please ignore this email.
    No action is needed — the verification code will expire automatically.
</div>
{{/inline}}
{{/layout}}
