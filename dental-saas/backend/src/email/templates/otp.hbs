{{#> layout subject=subject}}
{{#*inline "body"}}
<p style="font-size:15px; margin:0 0 8px;">Hello <strong>{{or name email}}</strong>,</p>
<p style="color:#64748b; font-size:14px; margin:0 0 24px; line-height:1.6;">
    Your one-time verification code is below. Use it to complete your action.
</p>

<div style="text-align:center; margin:32px 0;">
    <div
        style="display:inline-block; background:#f8fafc; border:2px dashed #2563eb; border-radius:12px; padding:24px 48px;">
        <p style="margin:0; font-size:11px; color:#64748b; text-transform:uppercase; letter-spacing:2px;">Your OTP Code
        </p>
        <p
            style="margin:8px 0 0; font-size:42px; font-weight:800; letter-spacing:12px; color:#1e3a5f; font-family:monospace;">
            {{otp}}</p>
    </div>
</div>

<table class="data">
    <tr>
        <th>Expires in</th>
        <td>5 minutes</td>
    </tr>
    <tr>
        <th>Issued at</th>
        <td>{{formatDate issuedAt}}</td>
    </tr>
</table>

<p style="font-size:13px; color:#888; margin-top:24px; line-height:1.6;">
    Never share this code with anyone. Our team will never ask for your OTP.
    If you did not request this code, please ignore this email.
</p>
{{/inline}}
{{/layout}}