{{#> layout subject=subject}}
{{#*inline "body"}}
<p style="font-size: 16px; margin: 0 0 8px; font-weight: 600;">Hello <strong>{{or name email}}</strong>,</p>
<p style="color: #64748b; font-size: 14px; margin: 0 0 28px; line-height: 1.7;">
    We received a request to reset your OrthoNoe account password. 
    Click the button below to create a new secure password.
</p>

<div style="text-align: center;">
    <table cellpadding="0" cellspacing="0" border="0" align="center">
        <tr>
            <td style="background: #2563eb; border-radius: 10px; box-shadow: 0 4px 14px rgba(37,99,235,0.3);">
                <a href="{{resetUrl}}" style="display: inline-block; padding: 16px 40px; color: #ffffff; text-decoration: none; font-weight: 700; font-size: 15px; letter-spacing: 0.3px;">
                    Reset My Password
                </a>
            </td>
        </tr>
    </table>
</div>

<hr class="divider" />

<table class="data">
    <tr>
        <th>Link expires in</th>
        <td><span class="pill pill-amber">15 minutes</span></td>
    </tr>
    <tr>
        <th>Requested at</th>
        <td>{{formatDate requestedAt}}</td>
    </tr>
    {{#if ipAddress}}
    <tr>
        <th>Request IP</th>
        <td style="font-family: monospace; font-size: 13px;">{{ipAddress}}</td>
    </tr>
    {{/if}}
</table>

<div class="security-box">
    <strong>⚠️ Security Warning:</strong> If you did not request a password reset, 
    please ignore this email or contact our support team immediately if you believe 
    your account has been compromised. This link will expire automatically after <strong>15 minutes</strong>.
</div>

<p style="color: #64748b; font-size: 13px; margin-top: 20px; line-height: 1.7;">
    If you didn't request this reset, no action is needed — your password remains unchanged.
</p>

<p style="font-size: 13px; color: #64748b; margin-top: 20px; line-height: 1.7;">
    Or copy and paste this URL into your browser:
</p>
<p style="word-break: break-all; font-size: 13px; color: #2563eb; background: #f8fafc; padding: 12px 16px; border-radius: 8px; border: 1px solid #e2e8f0;">
    {{resetUrl}}
</p>
{{/inline}}
{{/layout}}