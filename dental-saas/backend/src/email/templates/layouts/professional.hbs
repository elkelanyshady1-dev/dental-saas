{{#> layout subject=subject}}
{{#*inline "body"}}
<!--
  Professional Layout Wrapper
  Clean, clinical, authoritative. Used by orthodontists & supervisors.
  Used by: supervisorNotification, reportReady, clinical alerts
-->
<div style="border-left: 4px solid #2563eb; padding-left: 16px; margin-bottom: 24px;">
  <p style="font-size: 13px; color: #2563eb; font-weight: 700; text-transform: uppercase; letter-spacing: 1px; margin: 0 0 4px;">
    Clinical Notification
  </p>
  <p style="font-size: 11px; color: #94a3b8; margin: 0;">
    OrthoNoe Platform — Practitioner Communications
  </p>
</div>

{{{content}}}

<hr class="divider" />

<div style="background: #eff6ff; border-radius: 10px; padding: 16px 20px; margin-top: 20px;">
  <p style="margin: 0; font-size: 12px; color: #1e40af; line-height: 1.6;">
    <strong>Confidential</strong> — This message is intended for authorized clinical staff only. 
    It may contain patient data subject to HIPAA/GDPR protections.
  </p>
</div>
{{/inline}}
{{/layout}}
