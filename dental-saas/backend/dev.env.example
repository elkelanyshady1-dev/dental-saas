# ─────────────────────────────────────────────────────────────────────────────
# Development Environment Variables
# Copy this file to .env and fill in your values.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development

# ─── DEV AUTH MODE ────────────────────────────────────────────────────────────
# Set to "true" to enable the development authentication bypass.
# Requires NODE_ENV=development to have any effect.
# When active:
#   - OTP request: skips MongoDB write and SMS/email sending
#   - OTP verify:  accepts fixed code "123456" (pricingToken TTL = 24h)
#   - Signup:      derives region from phone if pricingToken is missing/expired
#   - Rate limits: all limits disabled (unlimited requests)
#   - Email:       user marked verified immediately
# NEVER set to "true" in production.
DEV_AUTH_MODE=true
